DirectoryIndex index.php

<IfModule mod_rewrite.c>
RewriteEngine On

# Force HTTPS on staging only — skip entirely on localhost/127.0.0.1
RewriteCond %{HTTP_HOST} ^staging\.letsseethemenu\.com$ [NC]
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://staging.letsseethemenu.com%{REQUEST_URI} [L,R=301]

# Hide .php extension (external redirect)
RewriteCond %{THE_REQUEST} \s/+(.+?)\.php[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# Serve extensionless paths as .php files internally
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.+?)/?$ $1.php [L]
</IfModule>
