DirectoryIndex index.php

<IfModule mod_rewrite.c>
RewriteEngine On

# Force HTTPS on any non-local host
RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:\d+)?$ [NC]
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Hide .php extension (external redirect)
RewriteCond %{THE_REQUEST} \s/+(.+?)\.php[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# Live URL parity: /state/{state}/city/{city}
RewriteRule ^state/([^/]+)/city/([^/]+)/?$ pages/locations.php?state=$1&city=$2 [L,QSA]

# Live URL parity: /state/{state}
RewriteRule ^state/([^/]+)/?$ pages/state.php?state=$1 [L,QSA]

# Live URL parity: /category/{slug}/post/{post-slug}
RewriteRule ^category/([^/]+)/post/([^/]+)/?$ pages/blog-single.php?category=$1&slug=$2 [L,QSA]

# Live URL parity: /category/{slug}
RewriteRule ^category/([^/]+)/?$ pages/category.php?slug=$1 [L,QSA]

# Live URL parity: /page/{slug}
RewriteRule ^page/([^/]+)/?$ pages/page-router.php?slug=$1 [L,QSA]

# Serve extensionless paths as .php in current directory tree (root, pages/, dashboard/, …)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.+?)/?$ $1.php [L]

# Fallback: map /contact → pages/contact.php (and /legal/… → pages/legal/…)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_URI} !^/.*/pages/
RewriteRule ^(.+?)/?$ pages/$1.php [L]
</IfModule>
